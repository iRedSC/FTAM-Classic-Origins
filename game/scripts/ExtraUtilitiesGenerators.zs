// Extra Utilities' stronger generators can't be crafted, in any size (single, 8x, 64x). The Survivalist (0) and
// Furnace (1) Generators keep their recipes. Generators already built or held keep working, so they aren't banned
// and stay listed in NEI. The shop, crates and envoy bags don't hand them out either (forge-1.7.10-mods:
// dev/value/skip.json).
// Lava
recipes.remove(<ExtraUtilities:generator:2>);
recipes.remove(<ExtraUtilities:generator.8:2>);
recipes.remove(<ExtraUtilities:generator.64:2>);
// Ender
recipes.remove(<ExtraUtilities:generator:3>);
recipes.remove(<ExtraUtilities:generator.8:3>);
recipes.remove(<ExtraUtilities:generator.64:3>);
// Heated Redstone
